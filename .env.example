# Copy to `.env` for local docker compose / next. Never commit real secrets.

# --- App ---
NODE_ENV=development
# Public URL of the Next.js app (Auth.js + absolute links)
AUTH_URL=http://localhost:3000
# Required by Auth.js v5 — generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# --- Auth bypass (local only; ignored when NODE_ENV=production) ---
AUTH_BYPASS=true
AUTH_BYPASS_EMAIL=local@ourtable.dev
AUTH_BYPASS_NAME=Local Tester

# --- Database (compose `db` service) ---
# Inside containers use host `db`; from the host machine use localhost:5433
# (compose maps db → host 5433 to avoid clashing with a local Postgres on 5432).
DATABASE_URL=postgresql://ourtable:ourtable@db:5432/ourtable
# DATABASE_URL_HOST=postgresql://ourtable:ourtable@localhost:5433/ourtable
POSTGRES_USER=ourtable
POSTGRES_PASSWORD=ourtable
POSTGRES_DB=ourtable

# --- Auth.js: Google OAuth ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Cloudflare R2 (photo uploads) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ourtable-photos
R2_PUBLIC_URL=
# Optional: custom endpoint if not using the default R2 URL shape
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com

# --- Internal cron (worker → app) ---
# Shared secret for X-Internal-Token on POST /api/cron/complete-planned-visits
INTERNAL_CRON_TOKEN=replace-me-with-a-long-random-string
# Base URL the worker uses to reach the app (compose service name in Docker)
APP_URL=http://app:3000
# Optional: node-cron expression (default hourly at :00)
# CRON_COMPLETE_PLANNED=0 * * * *

# --- Nominatim / Leaflet (maps & geocoding) ---
# Public Nominatim requires a descriptive User-Agent (OSM usage policy).
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=OurTable/0.1 (local-dev; replace-with-contact-email)
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

# --- Web Push (VAPID) — M8 ---
# Public key is safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Private key — server-only; never commit real values / never NEXT_PUBLIC_
VAPID_PRIVATE_KEY=
# Contact URI required by the Web Push protocol (mailto: or https:)
VAPID_SUBJECT=mailto:local@ourtable.dev
