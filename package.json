    "test:visit": "tsx --test tests/visit.test.ts",
    "test:rating": "tsx --test tests/rating.test.ts",
    "test:calendar": "tsx --test tests/calendar.test.ts",
    "test:photo": "tsx --test tests/photo.test.ts",
    "test:push": "tsx --test tests/push.test.ts",
    "test:offline": "tsx --test tests/offline-draft.test.ts",
