    "drizzle-orm": "^0.45.2",
    "idb": "^8.0.3",
    "lucide-react": "^1.27.0",
    "next": "15.5.22",
    "next-auth": "^5.0.0-beta.32",
    "node-cron": "^4.6.0",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.83.0",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
